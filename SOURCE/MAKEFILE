CC      = t:\bin\bcc.exe
ASM     = t:\bin\tasm.exe
LIB     = t:\bin\tlib.exe
INCDIR  = -It:\include -Ic:\include -I. -I..
CFLAGS  = -c -ml -1 -k- -O -Z $(INCDIR)
AFLAGS  = /ml /m2

OBJS = \
    AGI_BMP.OBJ \
    AGIDRV.OBJ \
    AGI_WIN.OBJ \
    DIALOG.OBJ \
    FILEOPEN.OBJ \
    GDI.OBJ \
    HARDERR.OBJ \
    HELP.OBJ \
    ICOAPP.OBJ \
    ICOASKM.OBJ \
    ICOERROR.OBJ \
    ICOEXCL.OBJ \
    ICOEXIT.OBJ \
    ICON.OBJ \
    ICOSTOP.OBJ \
    STA.OBJ \
    STRELINE.OBJ \
    TEXTOUT.OBJ \
    VGAFADE.OBJ \
    WINSIZE.OBJ

all: SDK.LIB

SDK.LIB: $(OBJS) SDK.RSP
    if exist SDK.LIB del SDK.LIB
    $(LIB) /C SDK.LIB @SDK.RSP
    if exist ..\SDK.LIB del ..\SDK.LIB
    copy SDK.LIB ..\SDK.LIB

AGI_BMP.OBJ: AGI_BMP.C STRETCH.C
    $(CC) $(CFLAGS) AGI_BMP.C

AGIDRV.OBJ: AGIDRV.C XMSMM.C
    $(CC) -c -ml -1 -r- $(INCDIR) AGIDRV.C

AGI_WIN.OBJ: AGI_WIN.C TIMER.C WINBASE.C WINDRAW.C WINEVT1.C WINEVT2.C WINTEXT.C WINDATA1.H WINDATA2.H
    $(CC) $(CFLAGS) AGI_WIN.C

DIALOG.OBJ: DIALOG.C
    $(CC) -c -ml -O1 $(INCDIR) DIALOG.C

FILEOPEN.OBJ: FILEOPEN.C
    $(CC) -B -c -ml -1 $(INCDIR) FILEOPEN.C

HARDERR.OBJ: HARDERR.C
    $(CC) -c -ml -1 -r- $(INCDIR) HARDERR.C

HELP.OBJ: HELP.C
    $(CC) -c -ml -1 -r- $(INCDIR) HELP.C

ICON.OBJ: ICON.C
    $(CC) -c -ml $(INCDIR) ICON.C

WINSIZE.OBJ: WINSIZE.C
    $(CC) -c -ml -1 -O1 $(INCDIR) WINSIZE.C

GDI.OBJ: GDI.ASM
    $(ASM) $(AFLAGS) GDI.ASM

STA.OBJ: STA.ASM
    $(ASM) $(AFLAGS) STA.ASM

STRELINE.OBJ: STRELINE.ASM
    $(ASM) $(AFLAGS) STRELINE.ASM

TEXTOUT.OBJ: TEXTOUT.ASM
    $(ASM) $(AFLAGS) TEXTOUT.ASM

VGAFADE.OBJ: VGAFADE.ASM
    $(ASM) $(AFLAGS) VGAFADE.ASM

ICOAPP.OBJ: ICOAPP.ASM
    $(ASM) $(AFLAGS) ICOAPP.ASM

ICOASKM.OBJ: ICOASKM.ASM
    $(ASM) $(AFLAGS) ICOASKM.ASM

ICOERROR.OBJ: ICOERROR.ASM
    $(ASM) $(AFLAGS) ICOERROR.ASM

ICOEXCL.OBJ: ICOEXCL.ASM
    $(ASM) $(AFLAGS) ICOEXCL.ASM

ICOEXIT.OBJ: ICOEXIT.ASM
    $(ASM) $(AFLAGS) ICOEXIT.ASM

ICOSTOP.OBJ: ICOSTOP.ASM
    $(ASM) $(AFLAGS) ICOSTOP.ASM

clean:
    if exist *.OBJ del *.OBJ
    if exist *.BAK del *.BAK
    if exist *.LOG del *.LOG
